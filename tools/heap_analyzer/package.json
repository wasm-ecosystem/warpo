{
  "name": "as-heap-analyzer",
  "version": "0.0.0",
  "description": "Analyze heap memory dumps from AssemblyScript programs (incremental runtime). Reports live objects, shallow/retained sizes, root types, and class-level summaries.",
  "type": "module",
  "bin": {
    "as-heap-analyzer": "bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "assemblyscript",
    "heap",
    "memory",
    "analyzer",
    "profiler",
    "wasm"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "wasmparser": "^5.11.1"
  }
}
