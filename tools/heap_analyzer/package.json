{
  "name": "as-heap-analyzer",
  "version": "0.0.0",
  "description": "Analyze heap memory dumps from AssemblyScript programs (incremental runtime). Reports live objects, shallow/retained sizes, root types, and class-level summaries.",
  "type": "module",
  "bin": {
    "as-heap-analyzer": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "assemblyscript",
    "heap",
    "memory",
    "analyzer",
    "profiler",
    "wasm"
  ],
  "dependencies": {
    "commander": "^14.0.3",
    "wasmparser": "^5.11.1"
  }
}
