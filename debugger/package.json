{
  "name": "warpo-debugger",
  "displayName": "Warpo Debugger",
  "description": "Debug adapter for Warpo WebAssembly projects",
  "version": "1.0.0",
  "icon": "icon.png",
  "type": "commonjs",
  "publisher": "wasm-ecosystem",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasm-ecosystem/warpo"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebugResolve:warpo"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Warpo",
      "properties": {
        "warpo.debugRuntime": {
          "type": "string",
          "default": "",
          "description": "Local development override for the Warpo DAP server script (dapServer.js). Leave empty for normal use; the extension resolves it from this project's node_modules/warpo package."
        }
      }
    },
    "debuggers": [
      {
        "type": "warpo",
        "label": "Warpo Debug",
        "languages": [
          "typescript"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "wasmFilePath"
            ],
            "properties": {
              "wasmFilePath": {
                "type": "string",
                "description": "Path to the wasm file to debug."
              },
              "sessionMode": {
                "type": "string",
                "enum": [
                  "wasm file",
                  "unittest"
                ],
                "default": "wasm file",
                "description": "Which Warpo debugging workflow to use for this session."
              },
              "warpoPath": {
                "type": "string",
                "description": "Optional path to the Warpo CLI entry script used by unittest mode. Defaults to the bundled CLI."
              },
              "entryFunctionName": {
                "type": "string",
                "default": "main",
                "description": "Name of the exported Wasm function to call."
              },
              "debugSessionLogging": {
                "type": "boolean",
                "default": false,
                "description": "Show Warpo debug session logs in the Debug Console."
              },
              "debugSessionLogFile": {
                "type": "string",
                "description": "Optional file path for detailed Warpo debug session logs. Relative paths are resolved from the workspace folder."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "default": [],
                "description": "Arguments to pass to the entry function."
              },
              "runtime": {
                "type": "string",
                "enum": [
                  "node"
                ],
                "default": "node",
                "description": "Which runtime to use for launching the Wasm file."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for resolving relative paths in the debug session. Defaults to workspace folder."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "warpo",
            "request": "launch",
            "name": "Warpo Debug (wasm file)",
            "wasmFilePath": "${workspaceFolder}/build/output.wasm",
            "sessionMode": "wasm file",
            "entryFunctionName": "main",
            "debugSessionLogging": false,
            "args": []
          },
          {
            "type": "warpo",
            "request": "launch",
            "name": "Warpo Debug (unittest)",
            "sessionMode": "unittest",
            "debugSessionLogging": false
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "npx eslint src/ test/",
    "test": "node --import tsx --test test/**/*.test.ts",
    "package": "vsce package"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.65.0",
    "@vscode/debugprotocol": "^1.65.0"
  },
  "devDependencies": {}
}
