{
  "extends": "../../types/tsconfig-std.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "outDir": "../build-parser",
    "allowJs": false,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "strict": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "esModuleInterop": true,
    "noEmit": false
  },
  "files": ["./index-parser.ts"]
}
